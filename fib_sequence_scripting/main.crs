#!/usr/bin/env run-cargo-script


use std::env;

fn main() {

    let a: Vec<String> = env::args().collect();

    if a.len() != 2 {
        eprintln!("you need to pass in a number");
        return;
    }

    let x: u32 = a[1].parse().unwrap();

    let answer = calculate_fib(x);

    println!("{}", answer);
}

fn calculate_fib(num: u32) -> u32 {

    if num == 1 {
        return 0;
    }

    if num == 2 {
        return 1;
    }

    let mut x: u32 = 1;
    let mut y: u32 = 1;
    let mut sum: u32 = 0;

    for _i in 2..num {
        sum = x + y;
        x = y;
        y = sum;
    }

    return sum;
}
